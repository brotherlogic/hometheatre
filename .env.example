# ==============================================================================
# Home Theatre: Automated DVD ISO Ripper & Kodi NFS Pipeline (.env.example)
# ==============================================================================
# Copy this file to .env or run ./install.sh to auto-detect and populate values.

# ------------------------------------------------------------------------------
# 1. Optical Drive Passthrough (auto-detected by install.sh via sysfs)
# ------------------------------------------------------------------------------
# Physical block device for the optical drive (mapped to /dev/sr0 in container)
OPTICAL_SR_DEVICE=/dev/sr0
# Matching generic SCSI character device required for SG_IO & CSS authentication
OPTICAL_SG_DEVICE=/dev/sg0
# Host group GID owning the optical drive device nodes (Debian/Ubuntu cdrom = 24)
CDROM_GID=24

# ------------------------------------------------------------------------------
# 2. Host NFS Mount & NAS Share Configuration
# ------------------------------------------------------------------------------
# Known host path where the NAS media share is mounted (bind-mounted to /mnt/nfs in DevPod)
HOST_NFS_DIR=/mnt/nfs
# Hostname or IP address of the NAS NFS server (used in host mount & Kodi nfs:// URLs)
NFS_SERVER=nas.local
# Resolved IPv4 address of NFS_SERVER (auto-resolved by install.sh for host mount addr=)
NFS_SERVER_IP=192.168.1.50
# Exported path on the NAS server (must contain or allow creating movies/, tv/, unidentified/)
NFS_PATH=/volume1/media
# NFS mount options (auto-negotiated by install.sh: nfsvers=4 with fallback to nfsvers=3,nolock)
NFS_OPTS=rw,nfsvers=4,hard,timeo=600,retrans=2,rsize=1048576,wsize=1048576,noatime

# ------------------------------------------------------------------------------
# 3. NFS File Ownership (auto-detected from NFS share owner by install.sh)
# ------------------------------------------------------------------------------
# Applied via thread-scoped setfsuid/setfsgid for root_squash NAS compatibility
PUID=1000
PGID=1000

# ------------------------------------------------------------------------------
# 4. Local Scratch Storage
# ------------------------------------------------------------------------------
# Host directory bind-mounted to /scratch for staging DVD rips and building ISOs.
# Requires >= 25 GiB free local disk space (30+ GiB recommended for dual-layer DVD-9).
SCRATCH_DIR=/var/lib/hometheatre/scratch

# ------------------------------------------------------------------------------
# 5. Metadata (TMDB), Web UI, DevPod Workspace & Notifications
# ------------------------------------------------------------------------------
# TMDB API credential (supports both v3 32-char hex API Key and v4 Bearer Read Access Token)
TMDB_API_KEY=your_tmdb_api_key_here
# Host port exposed for the embedded Web UI and unidentified disc tagging queue
WEB_PORT=8080
# Optional webhook URL (Slack/Discord/ntfy/generic JSON POST) for rip completion/alert events
WEBHOOK_URL=
# Dedicated DevPod workspace ID for the daemon container (distinct from the 'hometheatre' devcontainer)
DAEMON_WORKSPACE_ID=hometheatre-daemon
